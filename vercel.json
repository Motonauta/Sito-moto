{
  "redirects": [
    {
      "source": "/manuale/pulire-la-catena-con-il-petrolio-bianco-costa-un-quarto-e-funziona-meglio",
      "destination": "/manuale/non-facciamoci-fregare-pulire-la-catena-della-moto-alla-perfezione-con-pochi-euro",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/viaggi/:slug",
      "destination": "/api/viaggio?slug=:slug"
    },
    {
      "source": "/manuale/:slug",
      "destination": "/api/manuale?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/formati.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
